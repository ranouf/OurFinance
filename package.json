{
  "name": "ourfinance",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test:rules": "firebase emulators:exec --only firestore --project ourfinance-rules-test \"node --test tests/firestore-rules/*.test.mjs\"",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "test:worker": "tsx --test workers/ourfinance-api/tests/*.test.ts",
    "typecheck:worker": "tsc --ignoreConfig --noEmit --target es2022 --module esnext --moduleResolution bundler --strict --skipLibCheck workers/ourfinance-api/src/*.ts",
    "config:test": "node scripts/write-test-config.mjs"
  },
  "private": true,
  "packageManager": "npm@11.9.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/service-worker": "^22.2.0",
    "firebase": "^13.3.0",
    "jose": "^6.2.17",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.0",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@tailwindcss/postcss": "^4.3.5",
    "firebase-tools": "^15.36.0",
    "postcss": "^8.5.33",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2"
  }
}
