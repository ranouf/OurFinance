{
  "name": "ourfinance",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "lint": "eslint src/app workers/ourfinance-api/src workers/ourfinance-api/tests",
    "test:rules": "firebase emulators:exec --only firestore --project ourfinance-rules-test \"node --test tests/firestore-rules/*.test.mjs\"",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "test:worker": "tsx --test workers/ourfinance-api/tests/*.test.ts",
    "typecheck:worker": "tsc -p tsconfig.worker.json",
    "lint:worker": "eslint workers/ourfinance-api/src workers/ourfinance-api/tests",
    "config:test": "node scripts/write-test-config.mjs",
    "test:coverage": "node --import tsx --test --experimental-test-coverage --test-coverage-lines=80 --test-coverage-branches=80 --test-coverage-functions=80 tests/unit/*.test.ts workers/ourfinance-api/tests/*.test.ts"
  },
  "private": true,
  "packageManager": "npm@11.9.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/service-worker": "^22.2.0",
    "angularx-qrcode": "^22.0.1",
    "firebase": "^13.3.0",
    "jose": "^6.2.17",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@tailwindcss/postcss": "^4.3.5",
    "angular-eslint": "^22.7.0",
    "eslint": "^10.15.0",
    "firebase-tools": "^15.36.0",
    "postcss": "^8.5.33",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.73.0"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.7"
  }
}
